# ---------------------------------------------------------------------------
# EquiYield environment variables
#
# Local:   copy this file to .env and fill in the values, then restart `npm run dev`.
# Netlify: Site configuration > Environment variables > Add a variable.
#          Vite reads these at BUILD time, so redeploy after changing one.
# ---------------------------------------------------------------------------

# REQUIRED. Reown (WalletConnect) project ID for the Connect wallet modal.
# Get it at https://dashboard.reown.com (Create project > App Kit).
# In the same dashboard, add these domains to the project's allowlist:
#   https://equiyield.xyz
#   https://www.equiyield.xyz
#   http://localhost:5173   (local dev; add any other port you use)
# Without an allowlisted domain the modal opens but wallets refuse to connect.
VITE_REOWN_PROJECT_ID=

# OPTIONAL but recommended for production. Solana RPC endpoint used to read wallet
# balances. Defaults to the public https://api.mainnet-beta.solana.com, which is
# heavily rate limited; use Helius, Triton, QuickNode or your own node instead.
VITE_SOLANA_RPC=
